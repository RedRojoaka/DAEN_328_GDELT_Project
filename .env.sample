# Copy to .env. Never commit .env. See docs/DOCKER.md.
POSTGRES_DB=gdelt
POSTGRES_USER=gdelt
# REQUIRED: replace with a unique local password before the first startup.
POSTGRES_PASSWORD=
# Container networking values; Compose enforces these for Python services.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Browser port on your computer. Change to 8502 if 8501 is occupied.
DASHBOARD_PORT=8501
# Temporary handoff directory shared by the three ETL processes in one container.
ETL_WORK_DIR=/tmp/gdelt-etl
# Add extraction settings here once the team agrees on the starting window.
